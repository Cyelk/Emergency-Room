--- !u!114 &1460018162
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1460018160}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "CONTROLS:\r\n\r\n- \u039A\u03AF\u03BD\u03B7\u03C3\u03B7 \u03A0\u03B1\u03AF\u03BA\u03C4\u03B7
    \u03BC\u03B5 WASD \u03BA\u03B1\u03B9 \u03C0\u03B5\u03C1\u03B9\u03C3\u03C4\u03C1\u03BF\u03C6\u03AE
    \u03BA\u03AC\u03BC\u03B5\u03C1\u03B1\u03C2 \u03BC\u03B5 \u03C7\u03C1\u03AE\u03C3\u03B7
    \u03C4\u03BF\u03C5 \u03C0\u03BF\u03BD\u03C4\u03B9\u03BA\u03B9\u03BF\u03CD.\r\n-
    \u0391\u03BB\u03BB\u03B7\u03BB\u03B5\u03C0\u03AF\u03B4\u03C1\u03B1\u03C3\u03B7
    \u03B1\u03BD\u03C4\u03B9\u03BA\u03B5\u03B9\u03BC\u03AD\u03BD\u03C9\u03BD \u03BC\u03B5
    Right Click.\r\n- ESC: \u0391\u03C0\u03B5\u03BB\u03B5\u03C5\u03B8\u03AD\u03C1\u03C9\u03C3\u03B7
    \u03BA\u03AD\u03C1\u03C3\u03BF\u03C1\u03B1 (\u03B4\u03AD\u03C3\u03BC\u03B5\u03C5\u03C3\u03B7
    \u03BC\u03B5 click \u03B5\u03BD\u03C4\u03CC\u03C2 \u03C4\u03B7\u03C2 \u03BF\u03B8\u03CC\u03BD\u03B7\u03C2).\r\n-
    F1: \u0386\u03BD\u03BF\u03B9\u03B3\u03BC\u03B1/\u039A\u03BB\u03B5\u03AF\u03C3\u03B9\u03BC\u03BF
    On-Line Help (\u03AE \u03C7\u03C1\u03AE\u03C3\u03B7 \u03BA\u03AF\u03C4\u03C1\u03B9\u03BD\u03BF\u03C5
    \u03BA\u03BF\u03C5\u03BC\u03C0\u03B9\u03BF\u03CD \u03BA\u03B1\u03B9 \u03BA\u03BF\u03C5\u03BC\u03C0\u03B9\u03BF\u03CD
    \"\u039A\u03BB\u03B5\u03AF\u03C3\u03B9\u03BC\u03BF\").\r\n\r\n\r\nHOW TO PLAY:\r\n\r\n1.
    \u03A0\u03BB\u03B7\u03C3\u03B9\u03AC\u03C3\u03C4\u03B5 \u03AD\u03BD\u03B1 Hotspot
    (Vital Signs Monitor, Bed, Ventilator, Call Button).\r\n2. \u039A\u03BF\u03B9\u03C4\u03AC\u03BE\u03C4\u03B5
    \u03C4\u03BF \u03BC\u03B5 \u03C4\u03BF Crosshair (\u03BA\u03AD\u03BD\u03C4\u03C1\u03BF
    \u03BF\u03B8\u03CC\u03BD\u03B7\u03C2).\r\n3. \u03A0\u03AC\u03C4\u03AE\u03C3\u03C4\u03B5
    \u03B1\u03C1\u03B9\u03C3\u03C4\u03B5\u03C1\u03CC \u03BA\u03BB\u03B9\u03BA.\r\n4.
    \u0398\u03B1 \u03B1\u03BD\u03BF\u03AF\u03BE\u03B5\u03B9 \u03C4\u03BF EHR Panel
    \u03C3\u03C4\u03B1 \u03B4\u03B5\u03BE\u03B9\u03AC \u03C4\u03B7\u03C2 \u03BF\u03B8\u03CC\u03BD\u03B7\u03C2.\r\n5.
    \u0394\u03B9\u03B1\u03B2\u03AC\u03C3\u03C4\u03B5 \u03C4\u03BF \u03C3\u03B5\u03BD\u03AC\u03C1\u03B9\u03BF
    \u03BA\u03B1\u03B9 \u03B5\u03C0\u03B9\u03BB\u03AD\u03BE\u03C4\u03B5 \u03BA\u03AC\u03B8\u03B5
    \u03C6\u03BF\u03C1\u03AC \u03C4\u03B7\u03BD \u03BA\u03B1\u03C4\u03AC\u03BB\u03BB\u03B7\u03BB\u03B7
    \u03B5\u03BD\u03AD\u03C1\u03B3\u03B5\u03B9\u03B1.\r\n6. \u03A3\u03C5\u03BC\u03C0\u03BB\u03B7\u03C1\u03CE\u03C3\u03C4\u03B5
    \u03C4\u03B1 \u03C0\u03B5\u03B4\u03AF\u03B1 \u03C4\u03B5\u03BA\u03BC\u03B7\u03C1\u03AF\u03C9\u03C3\u03B7\u03C2.
    \u039F\u03B9 \u03BB\u03AD\u03BE\u03B5\u03B9\u03C2 \u03BA\u03BB\u03B5\u03B9\u03B4\u03B9\u03AC
    \u03B5\u03AF\u03BD\u03B1\u03B9 \u03BC\u03AD\u03C3\u03B1 \u03C3\u03C4\u03B1 \u03C3\u03B5\u03BD\u03AC\u03C1\u03B9\u03B1,
    \u03B4\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 case/accent sensitive.\r\n7.
    \u0395\u03C0\u03B9\u03BB\u03AD\u03BE\u03C4\u03B5 \"\u03A5\u03C0\u03BF\u03B2\u03BF\u03BB\u03AE\"
    \u03B3\u03B9\u03B1 \u03BD\u03B1 \u03BA\u03B1\u03C4\u03B1\u03C7\u03C9\u03C1\u03B7\u03B8\u03BF\u03CD\u03BD
    \u03C4\u03B1 \u03C4\u03B5\u03BA\u03BC\u03AE\u03C1\u03B9\u03B1.\r\n8. \u03A0\u03B1\u03C4\u03AE\u03C3\u03C4\u03B5
    \"\u03A3\u03C5\u03BD\u03AD\u03C7\u03B5\u03B9\u03B1\" \u03B3\u03B9\u03B1 \u03BD\u03B1
    \u03C0\u03C1\u03BF\u03C7\u03C9\u03C1\u03AE\u03C3\u03B5\u03C4\u03B5 \u03C3\u03C4\u03B7\u03BD
    \u03B5\u03C0\u03CC\u03BC\u03B5\u03BD\u03B7 \u03C6\u03AC\u03C3\u03B7 \u03C4\u03BF\u03C5
    \u03C3\u03B5\u03BD\u03B1\u03C1\u03AF\u03BF\u03C5.\r\n\r\n\r\nIMPORTANT NOTES:\r\n\r\n-
    \u039A\u03AC\u03C0\u03BF\u03B9\u03B5\u03C2 \u03B1\u03C0\u03BF\u03C6\u03AC\u03C3\u03B5\u03B9\u03C2
    \u03AD\u03C7\u03BF\u03C5\u03BD \u03C7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC \u03CC\u03C1\u03B9\u03BF!
    \u0397 \u03C0\u03B1\u03C1\u03B1\u03B2\u03AF\u03B1\u03C3\u03AE \u03C4\u03BF\u03C5
    \u03BF\u03B4\u03B7\u03B3\u03B5\u03AF \u03C3\u03B5 \u03BC\u03B5\u03AF\u03C9\u03C3\u03B7
    \u03C4\u03BF\u03C5 \u03C4\u03B5\u03BB\u03B9\u03BA\u03BF\u03CD \u03B2\u03B1\u03B8\u03BC\u03BF\u03CD.\r\n-
    \u039F\u03C1\u03B9\u03C3\u03BC\u03AD\u03BD\u03B5\u03C2 \u03B1\u03C0\u03B1\u03BD\u03C4\u03AE\u03C3\u03B5\u03B9\u03C2
    \u03BA\u03B1\u03C4\u03AC \u03C4\u03B7\u03BD \u03C4\u03B5\u03BA\u03BC\u03B7\u03C1\u03AF\u03C9\u03C3\u03B7
    \u03B1\u03C0\u03BF\u03B4\u03AF\u03B4\u03BF\u03C5\u03BD \u03BC\u03B5\u03B3\u03B1\u03BB\u03CD\u03C4\u03B5\u03C1\u03BF
    \u03B2\u03B1\u03B8\u03BC\u03CC, \u03BA\u03B1\u03B9 \u03AC\u03BB\u03BB\u03B5\u03C2
    \u03B1\u03C0\u03BF\u03B4\u03AF\u03B4\u03BF\u03C5\u03BD \u03B1\u03C1\u03BD\u03B7\u03C4\u03B9\u03BA\u03CC
    \u03B2\u03B1\u03B8\u03BC\u03CC.\r\n- \u0393\u03B9\u03B1 \u03BA\u03AC\u03C0\u03BF\u03B9\u03BF\u03C5\u03C2
    \u03BA\u03B1\u03B8\u03BF\u03BB\u03B9\u03BA\u03BF\u03CD\u03C2 \u03BA\u03B1\u03BD\u03CC\u03BD\u03B5\u03C2
    (\u03C0.\u03C7. SpO2 \u03BA\u03AC\u03C4\u03C9 \u03B1\u03C0\u03CC 90%), \u03B5\u03BD\u03B5\u03C1\u03B3\u03BF\u03C0\u03BF\u03B9\u03B5\u03AF\u03C4\u03B1\u03B9
    \u03C3\u03C5\u03BD\u03B1\u03B3\u03B5\u03C1\u03BC\u03CC\u03C2! \u0391\u03C0\u03B1\u03B9\u03C4\u03BF\u03CD\u03BD\u03C4\u03B1\u03B9
    \u03B1\u03BD\u03AC\u03BB\u03BF\u03B3\u03B5\u03C2 \u03C0\u03C1\u03AC\u03BE\u03B5\u03B9\u03C2.\r\n\r\n\r\nAIM:\r\n\r\n\u039A\u03AC\u03BD\u03C4\u03B5
    \u03C4\u03B9\u03C2 \u03BA\u03B1\u03BB\u03CD\u03C4\u03B5\u03C1\u03B5\u03C2 \u03B4\u03C5\u03BD\u03B1\u03C4\u03AD\u03C2
    \u03B5\u03C0\u03B9\u03BB\u03BF\u03B3\u03AD\u03C2 \u03C3\u03C4\u03BF\u03BD \u03BA\u03B1\u03C4\u03AC\u03BB\u03BB\u03B7\u03BB\u03BF
    \u03C7\u03C1\u03CC\u03BD\u03BF \u03BA\u03B1\u03B9 \u03BC\u03B5 \u03B5\u03C0\u03B1\u03C1\u03BA\u03AE
    \u03C4\u03B5\u03BA\u03BC\u03B7\u03C1\u03AF\u03C9\u03C3\u03B7, \u03CE\u03C3\u03C4\u03B5
    \u03BD\u03B1 \u03B1\u03C0\u03BF\u03B4\u03C9\u03B8\u03B5\u03AF \u03BF \u03BA\u03B1\u03BB\u03CD\u03C4\u03B5\u03C1\u03BF\u03C2
    \u03B4\u03C5\u03BD\u03B1\u03C4\u03CC\u03C2 \u03B2\u03B1\u03B8\u03BC\u03CC\u03C2
    \u03C3\u03B5\u03BD\u03B1\u03C1\u03AF\u03BF\u03C5."
